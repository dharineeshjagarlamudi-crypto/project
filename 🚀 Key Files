export function evaluateTask(task, weather) {
  if (task.type === "fertilize" && weather.rain > 20) {
    return { priority: "Delay", reason: "Heavy rain will wash fertilizer" };
  }
  if (task.type === "harvest" && weather.rain > 10) {
    return { priority: "Critical", reason: "Crop maturity + rain risk" };
  }
  if (task.type === "spray" && weather.wind > 15) {
    return { priority: "Delay", reason: "High wind → drift risk" };
  }
  return { priority: "Safe", reason: "No immediate risk" };
}

import { evaluateTask } from "../utils/rules";

export default function WhatIf() {
  const tasks = [
    { name: "Harvest Tomato", type: "harvest" },
    { name: "Fertilize Paddy", type: "fertilize" },
    { name: "Spray Chilli", type: "spray" },
    { name: "Irrigate Groundnut", type: "irrigate" },
  ];

  const weather = { rain: 15, wind: 10 };

  const simulate = (delayHours) => {
    return tasks.map(t => evaluateTask(t, { ...weather, rain: weather.rain + delayHours }));
  };

  return (
    <div className="p-6">
      <h1 className="text-2xl font-bold">What-If Simulator</h1>
      <button onClick={() => console.log(simulate(12))} className="btn">Wait 12h</button>
      <button onClick={() => console.log(simulate(24))} className="btn">Wait 24h</button>
    </div>
  );
}
